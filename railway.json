{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile"
  },
  "deploy": {
    "startCommand": "gunicorn -w 4 -b 0.0.0.0:$PORT api:app",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5
  },
  "healthcheck": {
    "path": "/health",
    "interval": 30,
    "timeout": 5,
    "retries": 3
  }
}
